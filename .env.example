
Sample ENV
# ------------------------------------------------------------------
# Nova Store — environment configuration
# Copy this file to .env and adjust values for your local setup.
# ------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- API Gateway ---
PORT_GATEWAY=8080

# --- Service ports ---
PORT_AUTH=3001
PORT_USER=3002
PORT_PRODUCT=3003
PORT_INVENTORY=3004
PORT_CART=3005
PORT_ORDER=3006
PORT_PAYMENT=3007
PORT_SHIPPING=3008
PORT_REVIEW=3009
PORT_SEARCH=3010
PORT_NOTIFICATION=3011

# Internal service URLs (used for service-to-service HTTP calls)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004
CART_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
SHIPPING_SERVICE_URL=http://localhost:3008
REVIEW_SERVICE_URL=http://localhost:3009
SEARCH_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=nova
DB_PASSWORD=nova_secret
# TLS for managed MySQL (Azure/GCP/AWS enforce it). Local MySQL: leave false.
DB_SSL=false
# Skip CA-cert verification for development against managed instances.
DB_SSL_INSECURE=true
# mysql2 caching_sha2_password: allow public-key retrieval over plaintext (dev only).
DB_ALLOW_PUBLIC_KEY=false
DB_USER_SCHEMA=nova_user
DB_PRODUCT_SCHEMA=nova_product
DB_INVENTORY_SCHEMA=nova_inventory
DB_CART_SCHEMA=nova_cart
DB_ORDER_SCHEMA=nova_order
DB_PAYMENT_SCHEMA=nova_payment
DB_SHIPPING_SCHEMA=nova_shipping
DB_REVIEW_SCHEMA=nova_review
DB_NOTIFICATION_SCHEMA=nova_notification

# --- JWT / Auth ---
# Generate strong secrets in production, e.g.: openssl rand -hex 64
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=nova-store
COOKIE_SECRET=dev_cookie_secret_change_me
COOKIE_SECURE=false

# --- Internal service-to-service auth (x-service-token header) ---
SERVICE_TOKEN=nova-internal

# --- Frontend ---
VITE_API_URL=/api
VITE_FRONTEND_URL=http://localhost:5173

# --- Payments (mock provider) ---
MOCK_PAYMENT_PROVIDER=success

# --- Admin bootstrap account (created by seed script) ---
ADMIN_EMAIL=admin@nova.dev
ADMIN_PASSWORD=NovaAdmin123!
